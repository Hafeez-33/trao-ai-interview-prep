# ==============================================================================
# Trao AI Interview Prep Kit — Environment Configuration Template
# ==============================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# --- DATABASE CONFIGURATION ---
# Local: mongodb://127.0.0.1:27017/trao_interview_prep
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trao_production?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/trao_interview_prep

# --- AUTHENTICATION & SESSIONS ---
# Long, cryptographically random secret string (Required in production)
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# --- GOOGLE GEMINI AI CONFIGURATION ---
# Your Google Gemini API Key
LLM_API_KEY=
# Active model identifier (e.g. gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- CORS & DOMAIN CONFIGURATION ---
# URL of the deployed frontend static site for CORS origins (e.g. https://<frontend-app>.onrender.com)
FRONTEND_URL=http://localhost:5173
